# Only publish the maintained source tree. Local research and distributions
# stay on disk; binary releases and corresponding-source bundles use Releases.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.github/
!/LICENSE
!/README.md
!/README.txt
!/THIRD-PARTY-NOTICES.txt
!/FxStudio.slnx
!/global.json
!/src/
!/tests/
!/tooling/
!/skills/
!/docs/
!/examples/
!/source-notices/
!/probes/
!/sdk/
!/third_party/

/sdk/*
!/sdk/BUILD-SERVICE.md
!/sdk/PROVISIONING-STATUS.md
!/sdk/examples/
/probes/*
!/probes/emulator/
/third_party/*
!/third_party/emuCasioCalc/

**/bin/
**/obj/
**/build/
**/build-*/
**/source/
**/__pycache__/
**/.vs/
**/.fxstudio/
**/.fxide-source/
**/integration-work/
**/node_modules/
**/results/
/tests/.build-project-tests/
/tooling/native-gdb/prefix/
/tooling/native-gdb/tmp/
/tooling/native-gdb/package-result.json
/tooling/native-sdk/*.json
!/tooling/native-sdk/target-runtime-manifest.json

*.user
*.log
*.bmp
*.pyc
*.pyo
*.exe
*.dll
*.pdb
*.obj
*.o
*.a
*.lib
*.elf
*.g1a
*.g3a
*.zip
*.tar*
*.nupkg
*.partial
.env
.env.*
project.fxide.json
