function(find_simple_library _library _version_header _version_macro)
  cmake_parse_arguments(CLV "" "PATH_VAR;VERSION_VAR" "OTHER_MACROS" ${ARGN})
  set(LIB_PATH "${FXSDK_LIB}/${_library}")
  set(HEADER_PATH "${FXSDK_INCLUDE}/${_version_header}")
  if(NOT EXISTS "${LIB_PATH}" OR NOT EXISTS "${HEADER_PATH}")
    message(SEND_ERROR "find_simple_library: missing ${LIB_PATH} or ${HEADER_PATH}")
    return()
  endif()
  if(DEFINED CLV_PATH_VAR)
    set("${CLV_PATH_VAR}" "${LIB_PATH}" PARENT_SCOPE)
  endif()
  file(READ "${HEADER_PATH}" CONTENT)
  string(REGEX MATCH "#[ \t]*define[ \t]+${_version_macro}[ \t]+\"([^\"]+)\"" MATCH "${CONTENT}")
  if(DEFINED CLV_VERSION_VAR)
    set("${CLV_VERSION_VAR}" "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endif()
  foreach(MACRO_NAME IN LISTS CLV_OTHER_MACROS)
    string(REGEX MATCH "#[ \t]*define[ \t]+${MACRO_NAME}[ \t]+([^\r\n]+)" MATCH "${CONTENT}")
    set("${MACRO_NAME}" "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endforeach()
endfunction()
