# Relocatable native Windows fxSDK toolchain for fx-9860G / fx-9860GIII.
get_filename_component(FXSDK_NATIVE_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR sh)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(FXSDK_PLATFORM fx)
set(FXSDK_PLATFORM_LONG fx9860G)
set(FXSDK_TOOLCHAIN sh-elf-)
set(CMAKE_C_COMPILER "${FXSDK_NATIVE_PREFIX}/bin/sh-elf-gcc.exe")
set(CMAKE_CXX_COMPILER "${FXSDK_NATIVE_PREFIX}/bin/sh-elf-g++.exe")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_OBJCOPY "${FXSDK_NATIVE_PREFIX}/bin/sh-elf-objcopy.exe")
set(CMAKE_AR "${FXSDK_NATIVE_PREFIX}/bin/sh-elf-ar.exe")
set(CMAKE_RANLIB "${FXSDK_NATIVE_PREFIX}/bin/sh-elf-ranlib.exe")
set(CMAKE_EXECUTABLE_SUFFIX "")
set(CMAKE_C_EXECUTABLE_SUFFIX "")
set(CMAKE_CXX_EXECUTABLE_SUFFIX "")
set(FXSDK_SYSROOT "${FXSDK_NATIVE_PREFIX}")
set(FXSDK_INCLUDE "${FXSDK_NATIVE_PREFIX}/sh3eb-elf/include")
set(FXSDK_LIB "${FXSDK_NATIVE_PREFIX}/sh3eb-elf/lib")
set(FXSDK_COMPILER_INSTALL "${FXSDK_NATIVE_PREFIX}/lib/gcc/sh3eb-elf/14.1.0")
set(FXSDK_CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(FXGXA_EXECUTABLE "${FXSDK_NATIVE_PREFIX}/bin/fxgxa.exe")
set(FXCONV_COMPILER_NAME "${FXSDK_NATIVE_PREFIX}/bin/fxconv.exe")
set(CMAKE_FIND_ROOT_PATH "${FXSDK_NATIVE_PREFIX}/sh3eb-elf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
add_compile_options(-mb -fno-builtin -nostdlib -Wa,--dsp)
add_compile_definitions(TARGET_FX9860G)
add_link_options(-nostdlib -Wl,--no-warn-rwx-segments)
link_libraries(-lgcc)
if(NOT FXSDK_PREFIX)
  set(FXSDK_PREFIX "$ENV{FXSDK_PREFIX}")
endif()
foreach(DIR IN LISTS FXSDK_PREFIX)
  include_directories("${DIR}/include")
  link_directories("${DIR}/lib")
endforeach()
