# Native adaptation of fxSDK 2.11 GenerateG1A; CMake performs Windows quoting.
function(generate_g1a)
  cmake_parse_arguments(G1A "" "TARGET;OUTPUT;NAME;INTERNAL;VERSION;DATE;ICON" "" ${ARGN})
  if(G1A_UNPARSED_ARGUMENTS OR NOT G1A_TARGET)
    message(FATAL_ERROR "generate_g1a requires TARGET and accepts OUTPUT, NAME, INTERNAL, VERSION, DATE, ICON")
  endif()
  if(DEFINED G1A_OUTPUT)
    get_filename_component(G1A_OUTPUT "${G1A_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  else()
    set(G1A_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${G1A_TARGET}.g1a")
  endif()
  set(FXGXA_ARGS)
  if(DEFINED G1A_NAME OR "NAME" IN_LIST G1A_KEYWORDS_MISSING_VALUES)
    list(APPEND FXGXA_ARGS "--name=${G1A_NAME}")
  endif()
  if(DEFINED G1A_ICON)
    get_filename_component(G1A_ICON "${G1A_ICON}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    list(APPEND FXGXA_ARGS "--icon=${G1A_ICON}")
  endif()
  foreach(FIELD INTERNAL VERSION DATE)
    if(DEFINED G1A_${FIELD})
      string(TOLOWER "${FIELD}" OPTION)
      list(APPEND FXGXA_ARGS "--${OPTION}=${G1A_${FIELD}}")
    endif()
  endforeach()
  add_custom_command(TARGET "${G1A_TARGET}" POST_BUILD
    COMMAND "${CMAKE_OBJCOPY}" -O binary -R .bss -R .gint_bss "$<TARGET_FILE:${G1A_TARGET}>" "${G1A_TARGET}.bin"
    COMMAND "${FXGXA_EXECUTABLE}" --g1a ${FXGXA_ARGS} -o "${G1A_OUTPUT}" "${G1A_TARGET}.bin"
    WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" VERBATIM)
  if(DEFINED G1A_ICON)
    set_property(TARGET "${G1A_TARGET}" APPEND PROPERTY LINK_DEPENDS "${G1A_ICON}")
  endif()
endfunction()
