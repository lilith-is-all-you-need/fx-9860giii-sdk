<Window x:Class="FxStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fx Studio" Width="1480" Height="920" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
  <DockPanel Background="#F3F5F7">
    <Border DockPanel.Dock="Top" Background="#F8FAFB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <StackPanel>
        <DockPanel Margin="18,10,18,2">
          <StackPanel Orientation="Horizontal"><Border Background="{StaticResource Accent}" CornerRadius="6" Padding="9,4"><TextBlock Text="fx" Foreground="White" FontSize="19" FontWeight="SemiBold"/></Border><TextBlock Text="STUDIO" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="10,0"/><TextBlock x:Name="ProjectTitle" VerticalAlignment="Center" Foreground="#61747F" Margin="14,0"/></StackPanel>
          <TextBlock Text="C / C++   •   fx-9860GIII" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#61747F" FontSize="12"/>
        </DockPanel>
        <Menu>
          <MenuItem Header="{DynamicResource File}"><MenuItem Header="{DynamicResource New}" Click="New_Click" InputGestureText="Ctrl+N"/><MenuItem Header="{DynamicResource Open}" Click="Open_Click" InputGestureText="Ctrl+O"/><MenuItem Header="{DynamicResource Demo}" Click="Demo_Click"/><Separator/><MenuItem Header="{DynamicResource Save}" Click="Save_Click" InputGestureText="Ctrl+S"/><MenuItem Header="{DynamicResource SaveAll}" Click="SaveAll_Click"/><MenuItem Header="{DynamicResource Find}" Click="Find_Click" InputGestureText="Ctrl+F"/><Separator/><MenuItem Header="{DynamicResource Export}" Click="Export_Click"/><MenuItem Header="{DynamicResource Exit}" Click="Exit_Click"/></MenuItem>
          <MenuItem Header="{DynamicResource Build}"><MenuItem Header="{DynamicResource BuildProject}" Click="Build_Click" InputGestureText="Ctrl+Shift+B"/><MenuItem Header="{DynamicResource CancelBuild}" Click="CancelBuild_Click"/><MenuItem Header="{DynamicResource Reveal}" Click="Reveal_Click"/></MenuItem>
          <MenuItem Header="{DynamicResource Run}">
            <MenuItem Header="{DynamicResource ImportBuild}" Click="ImportBuild_Click"/><Separator/>
            <MenuItem Header="{DynamicResource Start}" Click="Start_Click" InputGestureText="F5" IsEnabled="{Binding IsEnabled, ElementName=StartButton}"/>
            <MenuItem Header="{DynamicResource Pause}" Click="Pause_Click" IsEnabled="{Binding IsEnabled, ElementName=PauseButton}"/>
            <MenuItem Header="{DynamicResource Stop}" Click="Stop_Click" InputGestureText="Shift+F5" IsEnabled="{Binding IsEnabled, ElementName=StopButton}"/>
            <MenuItem x:Name="RestartMenu" Header="{DynamicResource Restart}" Click="Restart_Click"/><Separator/>
            <MenuItem Header="{DynamicResource Step}" Click="Step_Click" InputGestureText="F11" IsEnabled="{Binding IsEnabled, ElementName=StepButton}"/>
            <MenuItem Header="{DynamicResource Next}" Click="Next_Click" InputGestureText="F10" IsEnabled="{Binding IsEnabled, ElementName=NextButton}"/>
            <MenuItem Header="{DynamicResource Finish}" Click="Finish_Click" InputGestureText="Shift+F11" IsEnabled="{Binding IsEnabled, ElementName=FinishButton}"/>
            <MenuItem x:Name="RunToMenu" Header="{DynamicResource RunTo}" Click="RunTo_Click" InputGestureText="Ctrl+F10"/>
            <MenuItem Header="{DynamicResource StepInstruction}" Click="StepInstruction_Click" InputGestureText="Ctrl+Alt+F11" IsEnabled="{Binding IsEnabled, ElementName=StepButton}"/>
            <MenuItem Header="{DynamicResource NextInstruction}" Click="NextInstruction_Click" InputGestureText="Ctrl+Alt+F10" IsEnabled="{Binding IsEnabled, ElementName=NextButton}"/><Separator/>
            <MenuItem x:Name="BreakpointMenu" Header="{DynamicResource Breakpoint}" Click="Breakpoint_Click" InputGestureText="F9"/>
          </MenuItem>
          <MenuItem Header="{DynamicResource Tools}"><MenuItem Header="{DynamicResource PrepareAddin}" Click="PrepareAddin_Click"/><MenuItem Header="{DynamicResource Settings}" Click="Settings_Click"/><MenuItem Header="Language"><MenuItem Header="English" Click="English_Click"/><MenuItem Header="简体中文" Click="Chinese_Click"/></MenuItem></MenuItem>
          <MenuItem Header="{DynamicResource Help}"><MenuItem Header="{DynamicResource CalculatorKnowledge}" Click="CalculatorKnowledge_Click"/><MenuItem Header="{DynamicResource Guide}" Click="Guide_Click"/></MenuItem>
        </Menu>
        <DockPanel Margin="12,3,12,10">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BuildButton" Content="{DynamicResource Build}" Click="Build_Click" ToolTip="Ctrl+Shift+B"/>
            <ComboBox x:Name="BuildProfile" Width="100" SelectedIndex="0" VerticalContentAlignment="Center" Margin="6,3,14,3"><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Release"/></ComboBox>
            <Button x:Name="StartButton" Content="{DynamicResource Start}" Click="Start_Click" Background="#DDEFE9" BorderBrush="#ABCFC3" ToolTip="F5"/>
            <Button x:Name="PauseButton" Content="{DynamicResource Pause}" Click="Pause_Click"/>
            <Button x:Name="StopButton" Content="{DynamicResource Stop}" Click="Stop_Click"/>
            <Border Width="1" Background="{StaticResource Line}" Margin="11,5"/>
            <Button x:Name="NextButton" Content="{DynamicResource Next}" Click="Next_Click" ToolTip="F10"/><Button x:Name="StepButton" Content="{DynamicResource Step}" Click="Step_Click" ToolTip="F11"/><Button x:Name="FinishButton" Content="{DynamicResource Finish}" Click="Finish_Click" ToolTip="Shift+F11"/>
          </StackPanel>
          <TextBlock x:Name="ConnectionText" Text="OFFLINE WORKSPACE" FontSize="11" Foreground="#61747F" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#EDF3F2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel><TextBlock x:Name="StatusText" Text="{DynamicResource StatusReady}"/><TextBlock x:Name="CaretText" HorizontalAlignment="Right" Foreground="#61747F"/></DockPanel>
    </Border>
    <Grid Margin="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="150"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="6"/><ColumnDefinition Width="350" MinWidth="300"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="330"/><RowDefinition Height="6"/><RowDefinition Height="260" MinHeight="150"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" CornerRadius="6">
        <DockPanel><Border DockPanel.Dock="Top" Padding="12,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="{DynamicResource Project}" FontWeight="SemiBold" FontSize="11" Foreground="#61747F"/></Border><TreeView x:Name="ProjectTree" BorderThickness="0" Padding="5" MouseDoubleClick="ProjectTree_DoubleClick"/></DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2"><Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" CornerRadius="6"><TextBlock x:Name="WelcomeText" Text="{DynamicResource Welcome}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#61747F"/></Border><TabControl x:Name="EditorTabs" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged"/></Grid>
      <GridSplitter Grid.Column="3" Grid.RowSpan="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="4" Grid.RowSpan="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <DockPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource Calculator}" FontWeight="SemiBold" FontSize="11" Foreground="#61747F"/><TextBlock Text="GIII" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource Accent}"/></DockPanel>
          <TextBlock Text="{DynamicResource Target}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,14"/>
          <Border Background="#2E3E42" CornerRadius="9" Padding="10">
            <Grid Background="#C7D3C5" Height="146"><Image x:Name="ScreenImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock x:Name="ScreenPlaceholder" Text="{DynamicResource PreviewEmpty}" Foreground="#405143" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid>
          </Border>
          <TextBlock Text="{DynamicResource PreviewHint}" FontSize="11" Foreground="#61747F" Margin="0,9,0,10"/>
          <StackPanel Orientation="Horizontal" Margin="-3,-6,0,6"><Button x:Name="EnlargeScreenButton" Content="{DynamicResource EnlargeScreen}" Click="EnlargeScreen_Click" Padding="8,5"/><Button x:Name="SaveScreenButton" Content="{DynamicResource SaveScreen}" Click="SaveScreen_Click" Padding="8,5"/></StackPanel>
          <TextBlock x:Name="KeyStatus" Text="{DynamicResource KeyHint}" FontSize="11" Foreground="#61747F" Margin="0,0,0,5" TextWrapping="Wrap"/>
          <UniformGrid x:Name="FunctionKeys" Columns="6"/>
          <UniformGrid x:Name="ControlKeys" Columns="6" Margin="0,8,0,0"/>
          <UniformGrid x:Name="NumberKeys" Columns="5" Margin="0,8,0,0"/>
          <TextBlock x:Name="CpuStatus" Text="" FontSize="11" Foreground="#61747F" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </Border>
      <GridSplitter Grid.Row="1" Grid.Column="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <DockPanel Grid.Row="2" Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="#EDF3F2" Padding="8,5"><TextBlock x:Name="DebugContextText" Text="{DynamicResource InspectHint}" FontSize="11" TextWrapping="Wrap"/></Border>
      <TabControl x:Name="InspectorTabs">
        <TabItem Header="{DynamicResource Output}"><TextBox x:Name="OutputText" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="12" BorderThickness="0" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></TabItem>
        <TabItem Header="{DynamicResource Locals}"><DockPanel><Button x:Name="EditLocalButton" DockPanel.Dock="Bottom" Content="{DynamicResource EditValue}" Click="EditLocal_Click" HorizontalAlignment="Left"/><DataGrid x:Name="LocalsGrid" ToolTip="{DynamicResource InspectHint}"/></DockPanel></TabItem>
        <TabItem Header="{DynamicResource Watch}"><DockPanel><WrapPanel DockPanel.Dock="Bottom"><TextBox x:Name="WatchExpression" Width="180" Margin="5" KeyDown="WatchExpression_KeyDown"/><Button Content="{DynamicResource Add}" Click="AddWatch_Click"/><Button Content="{DynamicResource Remove}" Click="RemoveWatch_Click"/><Button x:Name="EditWatchButton" Content="{DynamicResource EditValue}" Click="EditWatch_Click"/></WrapPanel><DataGrid x:Name="WatchGrid" ToolTip="{DynamicResource InspectHint}"/></DockPanel></TabItem>
        <TabItem Header="{DynamicResource Stack}"><DataGrid x:Name="StackGrid" MouseDoubleClick="Stack_DoubleClick"/></TabItem>
        <TabItem Header="{DynamicResource Breakpoints}"><DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button x:Name="RemoveBreakpointButton" Content="{DynamicResource Remove}" Click="RemoveBreakpoint_Click"/><Button x:Name="ToggleEnabledButton" Content="{DynamicResource ToggleEnabled}" Click="ToggleEnabled_Click"/><Button x:Name="ConditionButton" Content="{DynamicResource Condition}" Click="Condition_Click"/><Button x:Name="WatchpointButton" Content="{DynamicResource Watchpoint}" Click="Watchpoint_Click"/></WrapPanel><DataGrid x:Name="BreakpointsGrid"/></DockPanel></TabItem>
        <TabItem Header="{DynamicResource Registers}"><DockPanel><Button x:Name="EditRegisterButton" DockPanel.Dock="Bottom" Content="{DynamicResource EditValue}" Click="EditRegister_Click" HorizontalAlignment="Left"/><DataGrid x:Name="RegistersGrid"/></DockPanel></TabItem>
        <TabItem Header="{DynamicResource Memory}"><DockPanel><WrapPanel DockPanel.Dock="Top"><TextBox x:Name="MemoryAddress" Text="$sp" Width="145" Margin="5"/><TextBox x:Name="MemoryLength" Text="128" Width="65" Margin="5"/><Button x:Name="ReadMemoryButton" Content="{DynamicResource Refresh}" Click="Memory_Click"/><Button x:Name="WriteMemoryButton" Content="{DynamicResource EditValue}" Click="WriteMemory_Click"/></WrapPanel><TextBox x:Name="MemoryText" IsReadOnly="True" FontFamily="Consolas" BorderThickness="0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
        <TabItem Header="{DynamicResource Disassembly}"><DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button Content="{DynamicResource StepInstruction}" Click="StepInstruction_Click" IsEnabled="{Binding IsEnabled, ElementName=StepButton}" ToolTip="Ctrl+Alt+F11"/><Button Content="{DynamicResource NextInstruction}" Click="NextInstruction_Click" IsEnabled="{Binding IsEnabled, ElementName=NextButton}" ToolTip="Ctrl+Alt+F10"/></WrapPanel><DataGrid x:Name="DisassemblyGrid"/></DockPanel></TabItem>
      </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
