<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FxStudio</AssemblyName>
    <RootNamespace>FxStudio.App</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="CalculatorKnowledge.json" LogicalName="FxStudio.CalculatorKnowledge.json" />
    <EmbeddedResource Include="../../probes/emulator/syscall-coverage.json" LogicalName="FxStudio.SyscallCoverage.json" />
    <ProjectReference Include="../FxStudio.Core/FxStudio.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
</Project>
